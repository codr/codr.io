---
import { FEATURES } from '@/config/features';

const { pathname } = Astro.url;
---

<header class="header">
  <div class="header-content">
    <div class="logo">
      <a href="/">
        <span class="logo-accent">&lt;</span>codr<span class="logo-accent"
          >/&gt;</span
        >
      </a>
    </div>
    <nav class="nav">
      <ul>
        <li>
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}
            >Home</a
          >
        </li>
        {
          FEATURES.SHOW_HEADER_LINKS && (
            <li>
              <a
                href="/projects"
                aria-current={
                  pathname.startsWith('/projects') ? 'page' : undefined
                }
              >
                Projects
              </a>
            </li>
          )
        }
        <li>
          <a
            href="/blog"
            aria-current={pathname.startsWith('/blog') ? 'page' : undefined}
            >Blog</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    container-type: scroll-state;
    width: 100%;
    top: 0;
    z-index: 1000;
  }

  .header::before {
    content: '';
    z-index: -1;
    position: absolute;
    inset: 0;
    background-color: transparent;

    transition: background-color 0.2s ease;
  }

  @container scroll-state(stuck: top) {
    .header::before {
      background-color: #fff;
      border-bottom: 1px solid hsl(220 15% 86% / 0.2);
    }
  }

  @supports not (container-type: scroll-state) {
    .header::before {
      background-color: #fff;
      border-bottom: 1px solid hsl(220 15% 86% / 0.2);
    }
  }

  .header-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    text-decoration: none;
    color: #666;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: #000;
  }

  .nav a[aria-current='page'] {
    color: #000;
    font-weight: 600;
    text-decoration: underline 3px;
    text-underline-offset: 6px;
  }

  .logo a {
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    color: #000;
    transition: color 0.2s ease;
  }

  .logo a:hover {
    color: #3245ff;
  }

  .logo-accent {
    font-family: ui-monospace, monospace;
    color: #3245ff;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .header {
      background: #111;
      border-bottom-color: #222;
    }

    .logo a {
      color: #fff;
    }

    .logo a:hover {
      color: #818cf8;
    }

    .logo-accent {
      color: #818cf8;
    }

    .nav a {
      color: #999;
    }

    .nav a:hover {
      color: #fff;
    }

    .nav a[aria-current='page'] {
      color: #fff;
    }
  }
</style>
