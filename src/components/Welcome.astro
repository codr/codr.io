---

---

<div id="container">
  <div id="background"></div>
  <div class="orb"></div>
  <section id="hero">
    <div>
      <span class="badge">Software Engineer</span>
    </div>
    <h1>Hi, I'm Cody</h1>
    <p class="intro">
      I'm a software engineer passionate about building tools, platforms, and
      frontend systems that increase leverage across entire teams.
    </p>
  </section>
</div>

<style>
  #container {
    display: flex;
    flex-direction: column;
    flex: 1;
    font-family:
      Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial,
      sans-serif;
    height: 100%;
    justify-content: center;
    align-items: center;
  }

  #background {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-size: 60px 60px;
    background-image:
      linear-gradient(hsl(220 15% 86%) 1px, transparent 1px),
      linear-gradient(90deg, hsl(220 15% 86%) 1px, transparent 1px);
  }

  .orb {
    position: absolute;
    width: 600px;
    height: 600px;
    background-color: hsl(200 75% 60% / 0.1);
    filter: blur(120px);
    border-radius: 50%;
  }

  #hero {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 2rem;
    text-align: center;
    width: 100%;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
    color: #3245ff;
    background: rgb(50 69 255 / 0.1);
    border: 1px solid rgb(50 69 255 / 0.2);
    border-radius: 9999px;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .intro {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #4b5563;
    margin: 1.5rem 0;
    max-width: 600px;
    text-wrap: balance;
  }

  @media (prefers-color-scheme: dark) {
    .badge {
      color: #818cf8;
      background: rgb(129 140 248 / 0.1);
      border-color: rgb(129 140 248 / 0.2);
    }

    .intro {
      color: #9ca3af;
    }
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 4.5rem;
    }
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: 6rem;
    }
  }

  @media screen and (max-width: 768px) {
    .intro {
      font-size: 1.1rem;
    }

    #hero {
      padding: 1.5rem;
    }
  }
</style>
