---

---

<div id="container">
  <div class="orb"></div>
  <section id="hero">
    <div>
      <span class="badge">Software Engineer</span>
    </div>
    <h1>Hi, I'm Cody</h1>
    <p class="intro">
      I'm a software engineer passionate about building tools, platforms, and
      frontend systems that increase leverage across entire teams.
    </p>
  </section>
</div>

<style>
  #container {
    display: flex;
    flex-direction: column;
    flex: 1;
    font-family:
      Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial,
      sans-serif;
    height: 100%;
    justify-content: center;
    align-items: center;
  }

  .orb {
    position: absolute;
    width: clamp(250px, 60vmin, 600px);
    height: clamp(250px, 60vmin, 600px);
    background-color: hsl(200 75% 60% / 0.1);
    filter: blur(120px);
    border-radius: 50%;
  }

  #hero {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 2rem;
    text-align: center;
    width: 100%;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-family: ui-monospace, monospace;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-soft-border);
    border-radius: 9999px;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--color-text);
  }

  .intro {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 1.5rem 0;
    max-width: 600px;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 4.5rem;
    }
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: 6rem;
    }
  }

  @media screen and (max-width: 768px) {
    .intro {
      font-size: 1.1rem;
    }

    #hero {
      padding: 1.5rem;
    }
  }
</style>
